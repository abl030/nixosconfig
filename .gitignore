./docker/immich/.env
.env*
changed.txt

# OpenTofu/Terraform state (managed by terranix)
vms/tofu/.state/
nix/vms/tofu/.state/
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
tfplan

# Nix build outputs and local caches
result
result-*
.cache/
__pycache__/
ha/esphome/secrets.yaml
ha/esphome/.esphome/

# Claude Code machine-local settings (autoMemoryDirectory etc.)
.claude/settings.local.json

# Per-agent local sidecars — PII the agent needs but must never be committed
.claude/agents/*.local.md

# Playwright MCP screenshot output dir (see .claude/agents/playwright.md)
.playwright-mcp/

# Beads tracker retired 2026-04-14 — see docs/beads-archive.md.
# Ignored in case any stray daemon recreates the directory.
.beads/

# cratedigger is its own repo (github:abl030/cratedigger) checked out
# alongside this one for convenience. The flake consumes it via the
# `cratedigger-src` input — nothing here depends on the local copy.
# Untracked so its own git activity doesn't drift this repo's index.
/cratedigger/
.worktrees

# Hermes agent scratch dir, created when hermes runs with cwd = repo root.
# Its home-dir counterpart holds `.env` and `auth.json` (see hermes/README.md),
# so this must never be committable. Authored plans belong in docs/plans/.
.hermes/

# gitops-pusher ETag cache from a manual `tailscale-acl-apply` run. The unit
# keeps the real cache in its StateDirectory (/var/lib/tailscale-acl-apply/);
# it is a per-apply operational artifact, not policy, and never belongs in the
# repo. See modules/nixos/services/tailscale/acl-apply.nix.
/version-cache.json

# Claude Code's worktree directory (EnterWorktree creates nested checkouts of
# this repo here). The bare `.worktrees` rule above does not match this path.
/.claude/worktrees/
